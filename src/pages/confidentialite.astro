---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { ENTREPRISE } from '../data/entreprise';
import * as ld from '../lib/schema';

const site = Astro.site!;
const path = '/confidentialite/';
const titre = 'Politique de confidentialité – AMCF, électricien à Castries';
const description =
  'Comment AMCF, électricien à Castries, collecte, utilise et protège les données transmises via le formulaire de devis, et comment exercer vos droits.';
const fil = [
  { nom: 'Accueil', path: '/' },
  { nom: 'Politique de confidentialité', path },
];
---

<Base
  titre={titre}
  description={description}
  schema={[ld.pageWeb(site, { path, titre, description, avecFilAriane: true }), ld.filAriane(site, path, fil)]}
>
  <PageHero titre="Politique de confidentialité" fil={fil} ctas={false} />
  <section class="section">
    <div class="container">
      <div class="prose">
        <h2>Responsable du traitement</h2>
        <p>
          {ENTREPRISE.nomLong}, {ENTREPRISE.adresse.codePostal} {ENTREPRISE.adresse.ville} — {ENTREPRISE.legal.dirigeant}.
        </p>

        <h2>Données collectées</h2>
        <p>
          Via le formulaire de demande de devis : nom, téléphone, e-mail (facultatif), commune, type de prestation et
          description de votre besoin. Ces données sont strictement nécessaires pour vous recontacter et établir un devis.
        </p>

        <h2>Finalité et base légale</h2>
        <p>
          Les données sont utilisées uniquement pour répondre à votre demande et, le cas échéant, établir un devis ou réaliser
          l’intervention. Le traitement repose sur votre consentement et sur les mesures précontractuelles prises à votre
          demande.
        </p>

        <h2>Destinataires</h2>
        <p>
          Les données sont destinées exclusivement à {ENTREPRISE.nom}. Elles transitent par
          {ENTREPRISE.formulaire.web3formsCle
            ? ' le service Web3Forms, qui transmet les demandes par e-mail,'
            : ` notre hébergeur (${ENTREPRISE.hebergeur.nom}), qui assure la réception des formulaires,`}
          et ne sont jamais vendues ni cédées à des tiers.
        </p>

        <h2>Durée de conservation</h2>
        <p>
          Les demandes sans suite sont supprimées au plus tard 3 ans après le dernier contact. Les données liées à une
          prestation sont conservées pendant la durée nécessaire au respect de nos obligations légales et comptables.
        </p>

        <h2>Vos droits</h2>
        <p>
          Vous disposez d’un droit d’accès, de rectification, d’effacement, d’opposition et de limitation du traitement de vos
          données. Pour l’exercer, contactez-nous au {ENTREPRISE.telephone}{ENTREPRISE.email && <> ou à {ENTREPRISE.email}</>}. Vous
          pouvez également introduire une réclamation auprès de la CNIL (<a href="https://www.cnil.fr" rel="noopener">www.cnil.fr</a>).
        </p>

        <h2>Cookies</h2>
        <p>
          Ce site n’utilise aucun cookie publicitaire ni outil de suivi. Aucune bannière de consentement n’est donc nécessaire.
        </p>
      </div>
    </div>
  </section>
</Base>
