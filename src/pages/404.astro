---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { ENTREPRISE, telHref } from '../data/entreprise';
---

<Base titre="Page introuvable | AMCF" description="Cette page n’existe pas ou a été déplacée." noindex>
  <section class="section nf">
    <div class="container nf-inner">
      <p class="nf-code" aria-hidden="true">404</p>
      <h1>Court-circuit : cette page est introuvable.</h1>
      <p class="lead">Elle a peut-être été déplacée. Revenez à l’accueil ou appelez-nous directement.</p>
      <div class="btn-row nf-ctas">
        <a class="btn btn--red btn--lg" href="/">Retour à l’accueil <Icon name="arrow" size={18} class="icon-arrow" /></a>
        <a class="btn btn--ghost btn--lg" href={telHref}><Icon name="phone" size={20} /> {ENTREPRISE.telephone}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf-inner {
    max-width: 760px;
    text-align: center;
  }
  .nf-code {
    margin: 0;
    color: transparent;
    -webkit-text-stroke: 2px var(--red);
    font-size: clamp(6rem, 18vw, 11rem);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 1;
  }
  .nf h1 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
  }
  .nf-ctas {
    justify-content: center;
  }
</style>
