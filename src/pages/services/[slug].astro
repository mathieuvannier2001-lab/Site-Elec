---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import AsideCall from '../../components/AsideCall.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import * as ld from '../../lib/schema';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}

const { service } = Astro.props;
const { Content } = await render(service);
const d = service.data;
const site = Astro.site!;
const path = `/services/${service.id}/`;

const autres = (await getCollection('services'))
  .filter((s) => s.id !== service.id)
  .sort((a, b) => a.data.ordre - b.data.ordre);
const villes = (await getCollection('villes')).sort((a, b) => a.data.nom.localeCompare(b.data.nom, 'fr'));
const articles = (await getCollection('conseils')).filter((c) => c.data.servicesLies.includes(service.id));

const fil = [
  { nom: 'Accueil', path: '/' },
  { nom: 'Services', path: '/services/' },
  { nom: d.nomCourt, path },
];

const schema = [
  ld.entreprise(site),
  ld.pageWeb(site, { path, titre: d.titreSeo, description: d.description, avecFilAriane: true }),
  ld.filAriane(site, path, fil),
  ld.service(site, { path, nom: d.titre, description: d.description, categorie: d.categorie }),
  ld.faq(site, path, d.faq),
];
---

<Base titre={d.titreSeo} description={d.description} schema={schema}>
  <PageHero eyebrow={d.categorie} titre={d.titre} lead={d.resume} fil={fil} icone={d.icone} />

  <section class="section">
    <div class="container layout">
      <article class="main">
        <div class="presta card reveal">
          <h2 class="presta-title">Nos prestations</h2>
          <ul class="checklist presta-list">
            {
              d.prestations.map((p) => (
                <li>
                  <Icon name="check" size={18} strokeWidth={2.5} />
                  <span>{p}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="prose">
          <Content />
        </div>
      </article>

      <aside class="aside">
        <div class="aside-sticky">
          <AsideCall />
          <nav class="aside-nav" aria-label="Autres services">
            <p class="aside-nav-title">Autres services</p>
            <ul>
              {
                autres.map((s) => (
                  <li>
                    <a href={`/services/${s.id}/`}>
                      <Icon name={s.data.icone} size={18} />
                      {s.data.nomCourt}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </aside>
    </div>
  </section>

  <Faq items={d.faq} titre={`${d.nomCourt} : vos questions`} />

  <section class="section section--tight" aria-labelledby="villes-titre">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Zone d’intervention</p>
        <h2 id="villes-titre">{d.nomCourt} à Castries, Montpellier et alentours</h2>
        <p>Nous intervenons pour ce service dans toutes les communes de notre secteur, notamment :</p>
      </div>
      <ul class="chips">
        {
          villes.map((v) => (
            <li>
              <a class="chip" href={`/electricien-${v.id}/`}>
                <Icon name="pin" size={15} /> Électricien {v.data.nom}
              </a>
            </li>
          ))
        }
      </ul>

      {
        articles.length > 0 && (
          <div class="related">
            <p class="related-title">À lire aussi</p>
            <ul class="related-list">
              {articles.map((a) => (
                <li>
                  <a href={`/conseils/${a.id}/`} class="link-arrow">
                    {a.data.titre} <Icon name="arrow" size={18} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .presta {
    margin-bottom: 3rem;
    background: var(--paper);
    border-color: transparent;
  }
  .presta-title {
    font-size: 1.35rem;
    margin-bottom: 1.25rem;
  }
  .presta-list {
    grid-template-columns: repeat(2, 1fr);
    gap: 0.85rem 1.5rem;
    margin: 0;
    font-weight: 600;
  }
  .aside-sticky {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    display: grid;
    gap: 1.25rem;
  }
  .aside-nav {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .aside-nav-title {
    margin: 0 0 0.75rem;
    font-weight: 760;
    font-stretch: 108%;
  }
  .aside-nav ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .aside-nav a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 0.2s;
  }
  .aside-nav li:last-child a {
    border-bottom: 0;
  }
  .aside-nav a:hover {
    color: var(--red);
  }
  .aside-nav :global(svg) {
    color: var(--red);
  }
  .related {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .related-title {
    font-weight: 760;
    font-stretch: 108%;
  }
  .related-list {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 960px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .aside-sticky {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .presta-list {
      grid-template-columns: 1fr;
    }
  }
</style>
