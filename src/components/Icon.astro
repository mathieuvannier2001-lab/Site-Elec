---
/**
 * Icônes en SVG intégré (aucun fichier externe à charger).
 * Utilisation : <Icon name="bolt" /> — les noms disponibles sont dans src/lib/icons.ts.
 */
import { ICONS } from '../lib/icons';

interface Props {
  name: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
}
const { name, size = 24, class: className, strokeWidth = 1.75 } = Astro.props;
const inner = ICONS[name] ?? ICONS.bolt;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={inner}
/>
