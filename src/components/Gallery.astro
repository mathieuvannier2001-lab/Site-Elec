---
/** Galerie de photos de chantiers (optimisées automatiquement à la construction du site). */
import { Picture, getImage } from 'astro:assets';
import type { Photo } from '../lib/photos';

interface Props {
  photos: Photo[];
}
const { photos } = Astro.props;

const items = await Promise.all(
  photos.map(async (p) => ({
    ...p,
    grande: await getImage({ src: p.src, width: Math.min(1600, p.src.width), format: 'webp' }),
  })),
);
---

<ul class="gallery">
  {
    items.map((p, i) => (
      <li class="reveal" style={`--d:${(i % 3) * 0.06}s`}>
        <a class="gallery-item" href={p.grande.src} target="_blank" rel="noopener">
          <Picture
            src={p.src}
            alt={p.legende}
            formats={['avif', 'webp']}
            widths={[480, 800, 1200].filter((w) => w <= p.src.width)}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
            loading="lazy"
            decoding="async"
          />
          <span class="gallery-caption">{p.legende}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gallery-item {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--paper);
  }
  .gallery-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .gallery-item:hover :global(img) {
    transform: scale(1.05);
  }
  .gallery-caption {
    position: absolute;
    inset: auto 0 0;
    padding: 2.5rem 1.1rem 1rem;
    background: linear-gradient(transparent, rgba(12, 13, 16, 0.85));
    color: #fff;
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.3;
  }
  @media (max-width: 1024px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
