---
/**
 * Illustration animée de la page d'accueil : un tableau électrique qui
 * « s'allume » module par module, puis le courant part vers la maison, le
 * portail, le réseau, la borne de recharge et l'éclairage.
 */
import Icon from './Icon.astro';
import { ICONS } from '../lib/icons';

type Module = { type: 'diff' | 'mod' | 'vide' };
const rangees: Module[][] = [
  [{ type: 'diff' }, ...Array.from({ length: 7 }, () => ({ type: 'mod' as const }))],
  [{ type: 'diff' }, ...Array.from({ length: 7 }, () => ({ type: 'mod' as const }))],
  [{ type: 'diff' }, ...Array.from({ length: 5 }, () => ({ type: 'mod' as const })), { type: 'vide' }, { type: 'vide' }],
];

const X0 = 180;
const W = 21;
const GAP = 1.5;
const H = 72;
const tops = [132, 232, 332];

let index = 0;
const modules = rangees.flatMap((rangee, r) => {
  let x = X0;
  return rangee.map((m) => {
    const w = m.type === 'diff' ? W * 2 + GAP : W;
    const item = { ...m, x, y: tops[r], w, i: m.type === 'vide' ? -1 : index++ };
    x += w + GAP;
    return item;
  });
});

const noeuds = [
  { x: 70, y: 170, icone: 'home', d: 'M160 214H122L96 188', delai: 0 },
  { x: 70, y: 400, icone: 'gate', d: 'M160 386H120L95 411', delai: 0.6 },
  { x: 490, y: 170, icone: 'network', d: 'M400 214H438L464 188', delai: 0.3 },
  { x: 490, y: 400, icone: 'charge', d: 'M400 386H440L465 411', delai: 0.9 },
  { x: 280, y: 515, icone: 'bulb', d: 'M280 460V485', delai: 1.2 },
];
---

<div class="panel-wrap" aria-hidden="true">
  <svg class="panel-svg" viewBox="0 0 560 560" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="pg-glow" cx="50%" cy="45%" r="50%">
        <stop offset="0" stop-color="#d22e24" stop-opacity=".45"></stop>
        <stop offset="1" stop-color="#d22e24" stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id="pg-body" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#22252d"></stop>
        <stop offset="1" stop-color="#14161b"></stop>
      </linearGradient>
      <linearGradient id="pg-mod" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f4f3ef"></stop>
        <stop offset="1" stop-color="#d9d7d1"></stop>
      </linearGradient>
    </defs>

    <circle cx="280" cy="260" r="260" fill="url(#pg-glow)"></circle>
    <g class="pg-rings" stroke="rgba(255,255,255,.06)">
      <circle cx="280" cy="260" r="150"></circle>
      <circle cx="280" cy="260" r="215"></circle>
      <circle cx="280" cy="260" r="275"></circle>
    </g>

    <!-- Câbles -->
    {
      noeuds.map((n) => (
        <g>
          <path d={n.d} class="pg-wire" />
          <path d={n.d} class="pg-flow" pathLength="100" style={`--delai:${n.delai + 1.8}s`} />
        </g>
      ))
    }

    <!-- Coffret -->
    <rect x="160" y="60" width="240" height="400" rx="20" fill="url(#pg-body)" stroke="rgba(255,255,255,.12)"></rect>
    <g transform="translate(180 76) scale(.24)" stroke="#d22e24" stroke-width="11">
      <path d="M41 40.5H23a17.5 17.5 0 0 1 0-35h21a14.5 14.5 0 0 1 14.5 14.5V46"></path>
      <path d="M77.5 46V24A18.5 18.5 0 0 1 96 5.5h16A18.5 18.5 0 0 1 130.5 24V46M104 18v28"></path>
      <path d="M64 59.5H23a17.5 17.5 0 0 0 0 35h41"></path>
      <path d="M77.5 100V78A18.5 18.5 0 0 1 96 59.5h40M104 77h32"></path>
    </g>
    <rect x="228" y="82" width="90" height="6" rx="3" fill="rgba(255,255,255,.1)"></rect>
    <rect x="228" y="94" width="56" height="5" rx="2.5" fill="rgba(255,255,255,.06)"></rect>
    <circle class="pg-led" cx="378" cy="88" r="4.5"></circle>
    <line x1="176" y1="114" x2="384" y2="114" stroke="rgba(255,255,255,.08)"></line>

    {
      tops.map((y) => (
        <g>
          <rect x="174" y={y + 28} width="212" height="14" rx="2" fill="#0b0c0f" />
          <rect x="180" y={y + 80} width="202" height="9" rx="2" fill="rgba(255,255,255,.05)" />
        </g>
      ))
    }

    <!-- Modules -->
    {
      modules.map((m) =>
        m.type === 'vide' ? (
          <g>
            <rect x={m.x} y={m.y} width={m.w} height={H} rx="3" fill="#262931" stroke="rgba(255,255,255,.06)" />
            <line x1={m.x + 5} y1={m.y + 30} x2={m.x + m.w - 5} y2={m.y + 30} stroke="rgba(255,255,255,.08)" />
            <line x1={m.x + 5} y1={m.y + 42} x2={m.x + m.w - 5} y2={m.y + 42} stroke="rgba(255,255,255,.08)" />
          </g>
        ) : (
          <g class="pg-mod" style={`--i:${m.i}`}>
            <rect x={m.x} y={m.y} width={m.w} height={H} rx="3" fill="url(#pg-mod)" />
            <rect x={m.x + 4} y={m.y + 6} width={m.w - 8} height="5" rx="1" fill="#c4c2bb" />
            <rect class="pg-ind" x={m.x + m.w / 2 - 3.5} y={m.y + 15} width="7" height="4" rx="1" />
            <rect x={m.x + m.w / 2 - 5.5} y={m.y + 25} width="11" height="28" rx="2.5" fill="#2a2d34" />
            <rect class="pg-lever" x={m.x + m.w / 2 - 4} y={m.y + 39} width="8" height="12" rx="2" fill={m.type === 'diff' ? '#d22e24' : '#ffffff'} />
            {m.type === 'diff' && <circle cx={m.x + m.w - 8} cy={m.y + 17} r="3.2" fill="#e8b416" />}
            <circle cx={m.x + 6} cy={m.y + 64} r="2" fill="#a9a7a1" />
            <circle cx={m.x + m.w - 6} cy={m.y + 64} r="2" fill="#a9a7a1" />
          </g>
        ),
      )
    }

    <!-- Presse-étoupes -->
    {[200, 240, 280, 320, 360].map((x) => <rect x={x - 7} y="440" width="14" height="20" rx="4" fill="#0b0c0f" stroke="rgba(255,255,255,.1)" />)}

    <!-- Points desservis -->
    {
      noeuds.map((n) => (
        <g class="pg-node" style={`--delai:${n.delai + 1.8}s`}>
          <circle class="pg-node-halo" cx={n.x} cy={n.y} r="30" />
          <circle cx={n.x} cy={n.y} r="30" fill="#15171c" stroke="rgba(255,255,255,.14)" />
          <g
            transform={`translate(${n.x - 13} ${n.y - 13}) scale(1.08)`}
            stroke="#fff"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={ICONS[n.icone]}
          />
        </g>
      ))
    }
  </svg>

  <div class="float-card float-card--a">
    <span class="float-icon"><Icon name="bolt" size={20} /></span>
    <span><strong>Dépannage 7j/7</strong><small>sur demande</small></span>
  </div>
  <div class="float-card float-card--b">
    <span class="float-icon float-icon--light"><Icon name="file" size={20} /></span>
    <span><strong>Devis gratuit</strong><small>clair et détaillé</small></span>
  </div>
</div>

<style>
  .panel-wrap {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
  }
  .panel-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .pg-rings {
    animation: spin 60s linear infinite;
    transform-origin: 280px 260px;
    stroke-dasharray: 4 10;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .pg-wire {
    stroke: rgba(255, 255, 255, 0.14);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }
  .pg-flow {
    stroke: #ff5245;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 16 200;
    stroke-dashoffset: 16;
    filter: drop-shadow(0 0 5px #ff5245);
    animation: courant 1.8s linear infinite;
    animation-delay: var(--delai);
    opacity: 0;
  }
  @keyframes courant {
    0% {
      stroke-dashoffset: 16;
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      stroke-dashoffset: -100;
      opacity: 0;
    }
  }
  .pg-led {
    fill: #2bd36b;
    filter: drop-shadow(0 0 6px #2bd36b);
    animation: led 2.4s ease-in-out infinite;
  }
  @keyframes led {
    50% {
      opacity: 0.45;
    }
  }
  .pg-ind {
    fill: #4a4d55;
    animation: ind-on 0.3s forwards;
    animation-delay: calc(var(--i) * 70ms + 0.4s);
  }
  @keyframes ind-on {
    to {
      fill: #2bd36b;
    }
  }
  .pg-lever {
    animation: lever-up 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: calc(var(--i) * 70ms + 0.4s);
  }
  @keyframes lever-up {
    to {
      transform: translateY(-11px);
    }
  }
  .pg-node-halo {
    fill: none;
    stroke: #ff5245;
    stroke-width: 2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: halo 1.8s ease-out infinite;
    animation-delay: calc(var(--delai) + 0.9s);
  }
  @keyframes halo {
    0% {
      opacity: 0.8;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1.45);
    }
  }

  .float-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.1rem 0.75rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    background: rgba(22, 24, 29, 0.72);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 20px 40px -18px rgba(0, 0, 0, 0.7);
    color: #fff;
    line-height: 1.2;
    animation: float 6s ease-in-out infinite;
  }
  .float-card strong {
    display: block;
    font-size: 0.95rem;
    font-stretch: 108%;
  }
  .float-card small {
    color: var(--ink-muted);
    font-size: 0.8rem;
  }
  .float-card--a {
    top: 4%;
    left: -2%;
  }
  .float-card--b {
    right: -2%;
    bottom: 3%;
    animation-delay: -3s;
  }
  .float-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: var(--red);
  }
  .float-icon--light {
    background: #fff;
    color: var(--ink);
  }
  @keyframes float {
    50% {
      transform: translateY(-10px);
    }
  }
  @media (max-width: 560px) {
    .float-card {
      padding: 0.55rem 0.8rem 0.55rem 0.55rem;
    }
    .float-card--a {
      left: 0;
    }
    .float-card--b {
      right: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pg-lever {
      transform: translateY(-11px);
    }
    .pg-ind {
      fill: #2bd36b;
    }
    .pg-flow {
      display: none;
    }
  }
</style>
